# ===== 本地调试开关 =====
# 设为 1 可在本地用 curl/Postman 测试时跳过小度签名校验（生产环境务必保持 0 或留空）
DEBUG_SKIP_SIGNATURE=0

# ===== 小度技能 Application ID（可选）=====
# 在 DuerOS 开放平台创建技能后获取，可用于在代码里二次校验请求是否属于你的技能
DUEROS_APPLICATION_ID=

# ===== 大模型配置（兼容 OpenAI Chat Completions 接口）=====
# --- DeepSeek 示例（默认）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# --- 也可换通义千问 / 豆包 / 自建兼容端点 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 系统提示词：控制 AI 的口吻与长度（音箱朗读建议短小口语化）
LLM_SYSTEM_PROMPT=你是运行在小度智能音箱上的 AI 助手，请用简洁、口语化、适合朗读的中文回答，每次不超过200字。
